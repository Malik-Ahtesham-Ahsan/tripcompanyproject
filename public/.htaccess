# TravelVista: clean page addresses (travelvista.uk/france-visa-from-uk)
Options -MultiViews
DirectorySlash Off
RewriteEngine On

# Old links: /index.html -> /   and   /page.html -> /page   (permanent redirect)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?#] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?#] [NC]
RewriteRule ^ /%1 [R=301,L]

# /page/ -> /page
RewriteCond %{REQUEST_URI} ^/(.+?)/$
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^ /%1 [R=301,L]

# Serve /page from page.html (takes priority over a folder with the same name)
RewriteCond %{REQUEST_URI} ^/([^.]+)$
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^ /%1.html [L]


# Appointment updates: always fetch the latest file, so manual edits show straight away
<IfModule mod_headers.c>
  <Files "appointments.json">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>

ErrorDocument 404 /404.html
